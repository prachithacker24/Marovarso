# Application Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/marovarso?schema=public"

# JWT Authentication Config
JWT_ACCESS_SECRET="your_jwt_access_secret_key_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_here"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="30d"

# OTP Settings
# Set to 'production' to use production SMS Gateway, or 'development' / 'local' for console logging
OTP_PROVIDER=development
OTP_EXPIRATION_MINUTES=5
OTP_COOLDOWN_SECONDS=30

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# Session Config
MAX_SESSIONS_PER_USER=5

# Cleanup Retention
OTP_CLEANUP_RETENTION_DAYS=7
SESSION_CLEANUP_RETENTION_DAYS=60
